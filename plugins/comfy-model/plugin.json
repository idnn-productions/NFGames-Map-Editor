{
  "id": "nfgames.comfy-model",
  "name": "3D model generation (ComfyUI)",
  "version": "1.0.0",
  "engines": { "nfgames": "^1.1.0" },
  "server": "server.mjs",
  "touches": { "files": [".nfgames/drafts/**", "models/**"], "commands": ["blender"], "network": true },
  "contributes": {
    "settings": {
      "comfyUrl": { "type": "string", "default": "http://127.0.0.1:8188", "title": "ComfyUI's address" },
      "workflowsDir": { "type": "string", "default": "", "title": "Workflows folder (your checkout of comfy-ui-model-workflows)" },
      "blender": { "type": "string", "default": "", "title": "Blender program (empty: found on the PATH or where it is usually installed)" }
    },
    "services": [{
      "id": "model",
      "title": "3D model generation",
      "summary": "Makes a 3D model from a draft's approved views, with ComfyUI and Blender on this computer",
      "provider": "ComfyUI on your computer",
      "actions": [
        { "id": "status", "title": "Check what it needs", "cost": { "estimate": 0 } },
        { "id": "generate", "title": "Generate a model", "cost": { "estimate": 0, "note": "runs on your GPU" } }
      ]
    }]
  },
  "activation": ["onService:model"]
}

{
  "id": "example.hello",
  "name": "Hello",
  "version": "1.0.0",
  "engines": { "nfgames": "^1.0.0" },
  "server": "server.mjs",
  "touches": { "files": [".hello/**"], "commands": [], "network": false },
  "contributes": {
    "commands": [{ "id": "greet", "title": "Say hello" }],
    "settings": { "greeting": { "type": "string", "default": "Hello", "title": "What to say" } }
  },
  "activation": ["onRoute", "onCommand:greet"]
}
